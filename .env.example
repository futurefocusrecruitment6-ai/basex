# Copy to .env for local dev (never commit .env)
MOTHERDUCK_TOKEN=your_motherduck_service_token

# Optional — database name is monitor_hub in sources/motherduck/connection.yaml
# MOTHERDUCK_DATABASE=monitor_hub

# Optional — MotherDuck Postgres endpoint host for /api/alerts/solved writes
# MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
